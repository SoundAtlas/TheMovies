<Window x:Class="TheMovies.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TheMovies.WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Registrer film" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Margin="0,0,0,20"/>
            <TextBlock Text="Titel" />
            <TextBox Text="{Binding AddMovieViewModel.Title}"
                     Margin="0,5,0,10"/>
            
            <TextBlock Text="Varighed(min)" />
            <TextBox Text="{Binding AddMovieViewModel.Duration}"
                     Margin="0,5,0,10"/>
            
            <TextBlock Text="Genre" />
            <TextBox Text="{Binding AddMovieViewModel.Genre}"
                     Margin="0,5,0,20"/>

            <Button Content="Registrer film"
                    Width="120"
                    HorizontalAlignment="Left"/>


        </StackPanel>
        
        
    </Grid>
</Window>
