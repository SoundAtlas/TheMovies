<Window x:Class="TheMovies.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TheMovies.WPF"
        mc:Ignorable="d"
        Title="TheMovies" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        MinHeight="700"
        MinWidth="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Ligger fast i toppen (uden for ScrollViewer'en), så den altid er synlig,
        uanset hvor langt man har scrollet ned i formularen. -->
        <Button Grid.Row="0"
                Content="← Tilbage"
                Click="TilbageKnap_Click"
                HorizontalAlignment="Left"
                Padding="10,4"
                Margin="20,20,0,0"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">


            <!-- FILM SEKTION -->

            <StackPanel Margin="20">
                <!-- ny knap til kalenderen-->
                <Button Content="Åbn kalender"
                        Command="{Binding OpenCalendarCommand}"
                        Width="120"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,20"/>
                <TextBlock Text="Registrer film"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>
                <TextBlock Text="Titel" />
                <TextBox Text="{Binding MovieViewModel.Title}"
                         Margin="0,5,0,10"/>

                <TextBlock Text="Varighed(min)" />
                <TextBox Text="{Binding MovieViewModel.Duration}"
                         Margin="0,5,0,10"/>

                <TextBlock Text="Genre" />
                <TextBox Text="{Binding MovieViewModel.Genre}"
                         Margin="0,5,0,10"/>

                <TextBlock Text="Filminstruktør" />
                <TextBox Text="{Binding MovieViewModel.Director}"
                         Margin="0,5,0,10"/>

                <TextBlock Text="Premieredato" />
                <DatePicker SelectedDate="{Binding MovieViewModel.ReleaseDate}"
                            Margin="0,5,0,10" Width="140" HorizontalAlignment="Left"/>

                <StackPanel Orientation="Horizontal">

                    <Button Content="Registrer film"
                            Command="{Binding MovieViewModel.RegisterMovieCommand}"
                            Width="120"
                            HorizontalAlignment="Left"
                            Margin="0,0,10,0" Click="Button_Click"/>
                    <Button Content="Gem ændringer"
                            Command="{Binding MovieViewModel.SaveMovieChangesCommand}"
                            Width="120"
                            HorizontalAlignment="Left"/>

                </StackPanel>

                <TextBlock Text="{Binding MovieViewModel.StatusMessage}"
                           Margin="0,10,0,0"/>

                <!-- FILM LISTE -->
                <TextBlock Text="Registrerede film:"
                           FontSize="16"
                           FontWeight="Medium"
                           Margin="0,10,0,10"/>

                <ListBox ItemsSource="{Binding MovieViewModel.Movies}"
                         SelectedItem="{Binding MovieViewModel.SelectedMovie}"
                         Margin="0,10,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" />
                                <TextBlock Text=" - " />
                                <TextBlock Text="{Binding Duration}" />
                                <TextBlock Text=" min - " />
                                <TextBlock Text="{Binding Genre}" />
                                <TextBlock Text=" - " />
                                <TextBlock Text="Filminstruktør: " />
                                <TextBlock Text="{Binding Director}" />
                                <TextBlock Text=" - " />
                                <TextBlock Text="Premieredato: " />
                                <TextBlock Text="{Binding ReleaseDate, StringFormat='{}{0:dd/MM/yyyy}'}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Content="Slet film"
                        Command="{Binding MovieViewModel.DeleteMovieCommand}"
                        Width="120"
                        HorizontalAlignment="Left"
                        Margin="0,10,0,0"/>

            </StackPanel>

        </ScrollViewer>

    </Grid>
</Window>
