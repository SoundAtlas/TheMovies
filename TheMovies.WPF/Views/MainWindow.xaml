<Window x:Class="TheMovies.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TheMovies.WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Registrer film" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Margin="0,0,0,20"/>
            <TextBlock Text="Titel" />
            <TextBox Text="{Binding AddMovieViewModel.Title}"
                     Margin="0,5,0,10"/>
            
            <TextBlock Text="Varighed(min)" />
            <TextBox Text="{Binding AddMovieViewModel.Duration}"
                     Margin="0,5,0,10"/>
            
            <TextBlock Text="Genre" />
            <TextBox Text="{Binding AddMovieViewModel.Genre}"
                     Margin="0,5,0,20"/>
            
            <TextBlock Text="Filminstruktør" />
            <TextBox Text="{Binding AddMovieViewModel.Director}"
                     Margin="0,5,0,10"/>

            <TextBlock Text="Premieredato" />
            <DatePicker SelectedDate="{Binding AddMovieViewModel.ReleaseDate}"
                        Margin="0,5,0,10" Width="140" HorizontalAlignment="Left"/>

            <Button Content="Registrer film"
                    Command="{Binding AddMovieViewModel.RegisterMovieCommand}"
                    Width="120"
                    HorizontalAlignment="Left"/>
            
            <TextBlock Text="Registrerede film:" 
                       FontSize="16" 
                       FontWeight="Medium" 
                       Margin="0,20,0,10"/>
            <Button Content="Slet film"
                    Command="{Binding AddMovieViewModel.DeleteMovieCommand}"
                    Width="120"
                    HorizontalAlignment="Left"/>                
            <ListBox ItemsSource="{Binding AddMovieViewModel.Movies}"
                     SelectedItem="{Binding AddMovieViewModel.SelectedMovie}"
         Margin="0,20,0,0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" />
                            <TextBlock Text=" - " />
                            <TextBlock Text="{Binding Duration}" />
                            <TextBlock Text=" min - " />
                            <TextBlock Text="{Binding Genre}" />
                            <TextBlock Text=" - " />
                            <TextBlock Text="Filminstruktør: " />
                            <TextBlock Text="{Binding Director}" />
                            <TextBlock Text=" - " />
                            <TextBlock Text="Premieredato: " />
                            <TextBlock Text="{Binding ReleaseDate, StringFormat='{}{0:dd/MM/yyyy}'}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </StackPanel>
        
        
    </Grid>
</Window>
