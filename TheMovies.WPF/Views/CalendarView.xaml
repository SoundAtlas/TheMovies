<Window x:Class="TheMovies.WPF.Views.CalendarView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kalender"
        Height="700"
        Width="1000"
        MinHeight="700"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Ligger øverst, så den er synlig uden at skulle scrolle den lange højre kolonne ned igen. -->
        <Button Grid.Row="0"
                Content="← Tilbage"
                Click="TilbageKnap_Click"
                HorizontalAlignment="Left"
                Padding="10,4"
                Margin="0,0,0,10"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- VENSTRE SIDE: kalendergitter -->
            <StackPanel Grid.Column="0"
                        Margin="0,0,10,0">

                <!-- VÆLG BIOGRAF -->
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,10">

                    <TextBlock Text="Biograf:"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <ComboBox Width="180"
                              ItemsSource="{Binding Cinemas}"
                              SelectedItem="{Binding SelectedCinema}"
                              DisplayMemberPath="Name"/>
                </StackPanel>

                <!-- MÅNEDSNAVIGATION -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="◀"
                            Width="30"
                            Command="{Binding PreviousMonthCommand}"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding MonthLabel}"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <Button Grid.Column="2"
                            Content="▶"
                            Width="30"
                            Command="{Binding NextMonthCommand}"/>
                </Grid>

                <!-- KALENDER -->
                <ListBox ItemsSource="{Binding Days}"
                         SelectedItem="{Binding SelectedDay}"
                         BorderThickness="0"
                         Background="Transparent">

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="90"
                                    Height="70"
                                    Margin="2"
                                    BorderBrush="LightGray"
                                    BorderThickness="1">
                                <Grid>
                                    <TextBlock Text="{Binding Date.Day}"
                                               Margin="4"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInCurrentMonth}"
                                                                 Value="False">
                                                        <Setter Property="Foreground"
                                                                Value="LightGray"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- RØD PRIK HVIS DER ER FORESTILLINGER -->
                                    <Ellipse Width="8"
                                             Height="8"
                                             Fill="Red"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Bottom"
                                             Margin="0,0,0,6"
                                             Visibility="{Binding HasScreenings,
                                             Converter={StaticResource BoolToVis}}"/>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>


            <!-- HØJRE SIDE -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <!-- OPRET FORESTILLING -->
                    <TextBlock Text="Opret forestilling"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <!-- FILM -->
                    <TextBlock Text="Film"/>
                    <ComboBox ItemsSource="{Binding Movies}"
                              SelectedItem="{Binding SelectedMovie}"
                              DisplayMemberPath="Title"
                              Margin="0,5,0,10"/>

                    <!-- SAL -->
                    <TextBlock Text="Sal"/>

                    <ComboBox ItemsSource="{Binding AvailableHalls}"
                              SelectedItem="{Binding SelectedHall}"
                              DisplayMemberPath="Name"
                              Margin="0,5,0,10"/>

                    <!-- DATO -->
                    <TextBlock Text="Dato"/>

                    <DatePicker SelectedDate="{Binding ScreeningDate}"
                                Margin="0,5,0,10"/>

                    <!-- STARTTID -->
                    <TextBlock Text="Starttid (tt:mm)"/>

                    <TextBox Text="{Binding ScreeningStartTime}"
                             Margin="0,5,0,10"/>


                    <!-- REGISTRER -->
                    <!-- REGISTRER / GEM ÆNDRINGER -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,10">

                        <Button Content="Registrer forestilling"
                                Command="{Binding RegisterScreeningCommand}"
                                Width="140"
                                Height="30"
                                Margin="0,0,10,0"/>

                        <Button Content="Gem ændringer"
                                Command="{Binding SaveScreeningChangesCommand}"
                                Width="120"
                                Height="30"/>

                    </StackPanel>


                    <!-- STATUS -->
                    <TextBlock Text="{Binding StatusMessage}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20"/>


                    <Separator Margin="0,0,0,20"/>


                    <!-- DAGSOVERSIGT -->
                    <TextBlock Text="Dagens forestillinger"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="{Binding SelectedDateLabel}"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <!-- FORESTILLINGER -->
                    <ListBox ItemsSource="{Binding Screenings}"
                             SelectedItem="{Binding SelectedScreening}">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock FontWeight="Bold">
                                        <Run Text="{Binding TimeSlot}"/>
                                        <Run Text=" - "/>
                                        <Run Text="{Binding MovieTitle}"/>
                                        <!--<Run Text="{Bi}"-->
                                    </TextBlock>

                                    <TextBlock>

                                        <Run Text="{Binding HallName}"/>
                                    </TextBlock>


                                    <TextBlock Text="Premiere!"
                                               Foreground="DarkRed"
                                               FontWeight="Bold"
                                               Visibility="{Binding IsPremiere,
                                               Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Book billetter"
                                Command="{Binding BookScreeningCommand}"
                                Width="140"
                                Height="30"
                                Margin="0,0,10,0"/>

                        <Button Content="{Binding ViewBookingsButtonText}"
                                Command="{Binding ViewBookingsCommand}"
                                Width="140"
                                Height="30"
                                Margin="0,0,10,0"/>

                    </StackPanel>

                    <TextBlock Text="{Binding BookingsFilterText}"
                               Foreground="DimGray"
                               Margin="0,6,0,0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">

                        <Button Content="Slet forestilling"
                                Command="{Binding DeleteScreeningCommand}"
                                Width="140"
                                Height="30"
                                Margin="0,0,10,0"/>
                    </StackPanel>

                </StackPanel>

            </ScrollViewer>

        </Grid>
    </Grid>

</Window>
