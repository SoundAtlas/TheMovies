<Window x:Class="TheMovies.WPF.Views.CalendarView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kalender" Height="600" Width="900">

	<Window.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVis"/>
	</Window.Resources>

	<Grid Margin="10">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="2*"/>
			<ColumnDefinition Width="1*"/>
		</Grid.ColumnDefinitions>

		<!-- VENSTRE SIDE: kalendergitter -->
		<StackPanel Grid.Column="0" Margin="0,0,10,0">

			<StackPanel Orientation="Horizontal" Margin="0,0,0,10">
				<TextBlock Text="Biograf:" VerticalAlignment="Center" Margin="0,0,8,0"/>
				<ComboBox Width="180"
                          ItemsSource="{Binding Cinemas}"
                          SelectedItem="{Binding SelectedCinema}"
                          DisplayMemberPath="Name"/>
			</StackPanel>

			<Grid Margin="0,0,0,10">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<Button Grid.Column="0" Content="◀" Width="30" Command="{Binding PreviousMonthCommand}"/>
				<TextBlock Grid.Column="1" Text="{Binding MonthLabel}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
				<Button Grid.Column="2" Content="▶" Width="30" Command="{Binding NextMonthCommand}"/>
			</Grid>

			<ListBox ItemsSource="{Binding Days}"
                     SelectedItem="{Binding SelectedDay}"
                     BorderThickness="0" Background="Transparent">
				<ListBox.ItemsPanel>
					<ItemsPanelTemplate>
						<UniformGrid Columns="7"/>
					</ItemsPanelTemplate>
				</ListBox.ItemsPanel>

				<ListBox.ItemTemplate>
					<DataTemplate>
						<Border Width="90" Height="70" Margin="2" BorderBrush="LightGray" BorderThickness="1">
							<Grid>
								<TextBlock Text="{Binding Date.Day}" Margin="4"
                                           HorizontalAlignment="Left" VerticalAlignment="Top">
									<TextBlock.Style>
										<Style TargetType="TextBlock">
											<Style.Triggers>
												<DataTrigger Binding="{Binding IsInCurrentMonth}" Value="False">
													<Setter Property="Foreground" Value="LightGray"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</TextBlock.Style>
								</TextBlock>

								<Ellipse Width="8" Height="8" Fill="Red"
                                         HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6"
                                         Visibility="{Binding HasScreenings, Converter={StaticResource BoolToVis}}"/>
							</Grid>
						</Border>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</StackPanel>

		<!-- HØJRE SIDE: dagsoversigt -->
		<StackPanel Grid.Column="1">
			<TextBlock Text="{Binding SelectedDateLabel}" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

			<ListBox ItemsSource="{Binding Screenings}">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<StackPanel Margin="0,0,0,8">
							<TextBlock FontWeight="Bold">
                                <Run Text="{Binding TimeSlot}"/>
                                <Run Text=" - "/>
                                <Run Text="{Binding MovieTitle}"/>
							</TextBlock>
							<TextBlock>
                                <Run Text="Sal "/>
                                <Run Text="{Binding Hall}"/>
							</TextBlock>
							<TextBlock Text="Premiere!" Foreground="DarkRed" FontWeight="Bold"
                                       Visibility="{Binding IsPremiere, Converter={StaticResource BoolToVis}}"/>
						</StackPanel>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>

			<Button Content="Tilbage" Margin="0,20,0,0" Click="TilbageKnap_Click"/>
		</StackPanel>
	</Grid>
</Window>