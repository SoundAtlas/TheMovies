<Window x:Class="TheMovies.WPF.Views.BookingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Book billetter" Height="300" Width="360" WindowStartupLocation="CenterOwner" MinHeight="300" MinWidth="360">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Antal billetter"/>
            <TextBox x:Name="BookingAmountBox"
                     Text="{Binding BookingAmount, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                     Margin="0,5,0,0"
                     PreviewTextInput="BookingAmount_PreviewTextInput"/>

            <TextBlock Foreground="Red" FontSize="12" Margin="0,2,0,8"
                       Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=BookingAmountBox}"
                       Visibility="{Binding ElementName=BookingAmountBox, Path=(Validation.HasError), Converter={StaticResource BoolToVis}}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Pladser tilbage: " FontWeight="Bold"/>
                <TextBlock Text="{Binding SeatsLeft}" />
            </StackPanel>

            <TextBlock Text="Email"/>

            <TextBox x:Name="EmailBox"
                     Text="{Binding Email,
                     UpdateSourceTrigger=PropertyChanged,
                     ValidatesOnDataErrors=True}"
                     Margin="0,5,0,0"/>

            <TextBlock Foreground="Red"
                       FontSize="12"
                       Margin="0,2,0,8"
                       Text="{Binding (Validation.Errors)[0].ErrorContent,
                       ElementName=EmailBox}"
                       Visibility="{Binding ElementName=EmailBox,
                       Path=(Validation.HasError),
                       Converter={StaticResource BoolToVis}}"/>

            <TextBlock Text="Telefonnummer"/>

            <TextBox x:Name="PhoneBox"
                     Text="{Binding PhoneNumber,
                     UpdateSourceTrigger=PropertyChanged,
                     ValidatesOnDataErrors=True}"
                     Margin="0,5,0,0"/>

            <TextBlock Foreground="Red"
                       FontSize="12"
                       Margin="0,2,0,8"
                       Text="{Binding (Validation.Errors)[0].ErrorContent,
                       ElementName=PhoneBox}"
                       Visibility="{Binding ElementName=PhoneBox,
                       Path=(Validation.HasError),
                       Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Annuller" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Book" Width="80" Click="Ok_Click" IsEnabled="{Binding CanBook}"/>
        </StackPanel>

    </Grid>
</Window>