<Window x:Class="TheMovies.WPF.Views.BookingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bookinger" Height="400" Width="750" WindowStartupLocation="CenterOwner"
        MinHeight="400" MinWidth="750">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding ScopeTitle}"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <ListBox Grid.Row="1" x:Name="BookingsList" ItemsSource="{Binding Bookings}" SelectedItem="{Binding SelectedBooking}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="Dato: " FontWeight="Bold" />
                        <TextBlock Text="{Binding ScreeningDate, StringFormat=d}"/>
                        <TextBlock Text=" " />
                        <TextBlock Text="Tid: " FontWeight="Bold" />
                        <TextBlock Text="{Binding ScreeningStart, StringFormat=hh\:mm}"/>
                        <TextBlock Text=" " />
                        <TextBlock Text="Film: " FontWeight="Bold" />
                        <TextBlock Text="{Binding MovieTitle}"/>
                        <TextBlock Text=" - " />
                        <TextBlock Text="{Binding HallName}" FontWeight="Bold" />
                        <TextBlock Text=" - " />
                        <TextBlock Text="Antal billetter til booking: " FontWeight="Bold" />
                        <TextBlock Text="{Binding BookingAmount}"/>
                        <TextBlock Text=" " />
                        <TextBlock Text="Email: " FontWeight="Bold" />
                        <TextBlock Text="{Binding Email}"/>
                        <TextBlock Text=" " />
                        <TextBlock Text="Telefonnummer: " FontWeight="Bold" />
                        <TextBlock Text="{Binding PhoneNumber}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Rediger" Width="80" Margin="0,0,8,0" Click="Edit_Click"/>
            <Button Content="Slet" Width="80" Click="Delete_Click"/>
        </StackPanel>
    </Grid>

</Window>
