<Window x:Class="TheMovies.WPF.Views.StartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="The Movies" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        MinHeight="700"
        MinWidth="1000">

    <Window.Resources>
        <!-- Bruges til at slå HasScreeningsToday/HasNoScreeningsToday om til Visibility. -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tilbage til velkomstskærmen for at vælge en anden biograf. -->
        <Button Grid.Row="0"
                Content="← Skift biograf"
                Command="{Binding ChangeCinemaCommand}"
                HorizontalAlignment="Left"
                Padding="10,4"
                Margin="0,0,0,20"/>

        <!-- Lille "The Movies" over det store bynavn - bynavnet fylder mest, fordi det er
        det, der siger hvilken biograf man står i. -->
        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <TextBlock Text="The Movies" FontSize="20"/>
            <TextBlock Text="{Binding SelectedCinema.Name}"
                       FontSize="32"
                       FontWeight="Bold"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,10,0,0">
                <Button Content="Se kalender"
                        Command="{Binding OpenCalendarCommand}"
                        Width="160"
                        Margin="0,0,0,10" Height="60"/>

                <Button Content="Opret film"
                        Command="{Binding CreateMovieCommand}"
                        Width="160"
                        Margin="0,0,0,10" Height="60"/>
            </StackPanel>

            <!-- Dagsoversigten, samme stil som film-/biograf-/sal-listerne i MainWindow. -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="Dagsoversigt"
                           FontSize="28"
                           FontWeight="Bold"
                           Margin="0,0,0,4"/>

                <TextBlock Text="{Binding TodayLabel}"
                           Margin="0,0,0,10"/>

                <Separator Margin="0,0,0,10"/>

                <ListBox ItemsSource="{Binding TodaysScreenings}"
                         Visibility="{Binding HasScreeningsToday, Converter={StaticResource BoolToVis}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding TimeSlot}" FontWeight="Bold"/>
                                <TextBlock Text=" - "/>
                                <TextBlock Text="{Binding MovieTitle}"/>
                                <TextBlock Text=" - "/>
                                <TextBlock Text="{Binding HallName}"/>
                                <TextBlock Text=" - "/>
                                <TextBlock Text="Pladser tilbage: " FontWeight="Bold"/>
                                <TextBlock Text="{Binding SeatsLeft}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="Ingen forestillinger i dag..."
                           FontSize="20"
                           FontStyle="Italic"
                           Visibility="{Binding HasNoScreeningsToday, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
